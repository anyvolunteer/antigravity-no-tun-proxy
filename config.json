{
  "fake_ip": {
    "cidr": "198.18.0.0/15",
    "enabled": true
  },
  "_version": "antigravity-universal-no-tun-2.0",
  "_comment": "Universal No-TUN proxy configuration for Antigravity Ecosystem. Set proxy.port to your local proxy port (e.g. 7897, 7890, 10808).",
  "_proxy_core": "based-on-antigravity-proxy",
  "traffic_logging": false,
  "target_processes": [
    "agy.exe",
    "agy",
    "Antigravity IDE.exe",
    "Antigravity IDE",
    "Antigravity.exe",
    "language_server_windows_x64.exe",
    "language_server_windows",
    "language_server.exe",
    "node.exe",
    "git.exe",
    "gh.exe"
  ],
  "proxy_rules": {
    "allowed_ports": [
      80,
      443
    ],
    "udp_fallback": "block",
    "ipv6_mode": "proxy",
    "routing": {
      "rules": [],
      "use_default_private": true,
      "default_action": "proxy",
      "enabled": true,
      "priority_mode": "order"
    },
    "udp_mode": "block",
    "dns_mode": "direct"
  },
  "child_injection_mode": "filtered",
  "timeout": {
    "recv": 10000,
    "connect": 10000,
    "send": 10000
  },
  "log_level": "info",
  "child_injection": true,
  "proxy": {
    "port": 7897,
    "type": "socks5",
    "host": "127.0.0.1"
  },
  "child_injection_exclude": []
}
